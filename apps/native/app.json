{
  "expo": {
    "name": "Wiki Collection",
    "icon": "./assets/icon.png",
    "slug": "wiki-collection",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wiki-collection",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matsupiee.wikicollection",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.matsupiee.wikicollection"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ja",
            "en"
          ]
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "26f70ca4-5015-4a54-8781-0edbddb3bb70"
      }
    }
  }
}
