{
  "name": "@wiki-collection/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "seed": "bun src/seed/index.ts",
    "seed:images": "bun src/seed/images.ts",
    "seed:wiki": "bun src/seed/wiki-cli.ts",
    "seed:battle": "bun src/seed/battle-cli.ts",
    "battle:run": "bun src/seed/run-battles.ts"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "@paralleldrive/cuid2": "2.2.2",
    "drizzle-orm": "catalog:",
    "libsql": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@wiki-collection/config": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "wrangler": "4.148.0"
  }
}
