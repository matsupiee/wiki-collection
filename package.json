{
  "name": "wiki-collection",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @wiki-collection/db --",
    "deploy": "turbo run deploy -F @wiki-collection/infra --",
    "destroy": "turbo run destroy -F @wiki-collection/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write",
    "db:seed": "bun run --cwd packages/db seed",
    "dev:local": "bun run --cwd apps/web dev:local",
    "test": "bun run --cwd packages/api test && bun run --cwd packages/wiki-import test && bun run --cwd apps/web test && bun run --cwd apps/native test",
    "wiki:import": "bun run --cwd packages/wiki-import import",
    "wiki:load": "bun run --cwd packages/wiki-import load",
    "wiki:top": "bun run --cwd packages/wiki-import top",
    "wiki:images": "bun run --cwd packages/wiki-import images",
    "db:seed:images": "bun run --cwd packages/db seed:images",
    "db:seed:packs": "bun packages/db/src/seed/packs-cli.ts",
    "db:seed:wiki": "bun run --cwd packages/db seed:wiki",
    "wiki:lengths": "bun run --cwd packages/wiki-import lengths",
    "db:seed:battle": "bun run --cwd packages/db seed:battle",
    "battle:run": "bun run --cwd packages/db battle:run",
    "db:seed:battle:ux": "bun run --cwd packages/db seed:battle:ux",
    "db:seed:fusion": "bun run --cwd packages/db seed:fusion",
    "db:seed:stats": "bun run packages/db/src/seed/stat-icons-cli.ts",
    "db:seed:collection": "bun run packages/db/src/seed/collection-sort-cli.ts",
    "db:seed:elements": "bun run packages/db/src/seed/element-icons-cli.ts",
    "dev:native": "bun run --cwd apps/native start",
    "dev:native:web": "bun run --cwd apps/native web",
    "db:seed:native": "bun packages/db/src/seed/native-cli.ts",
    "test:native:e2e": "playwright test --config playwright.native.config.ts",
    "db:seed:opening": "bun packages/db/src/seed/opening-juice-cli.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.4.1",
    "@wiki-collection/config": "workspace:*",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
