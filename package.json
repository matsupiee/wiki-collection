{
  "name": "wiki-collection",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @wiki-collection/db --",
    "deploy": "turbo run deploy -F @wiki-collection/infra --",
    "destroy": "turbo run destroy -F @wiki-collection/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write",
    "dev:local": "bun run --cwd apps/web dev:local",
    "test": "bun run --cwd packages/auth test && bun run --cwd packages/api test && bun run --cwd packages/wiki-import test && bun run --cwd apps/web test && bun run --cwd apps/native test",
    "dev:native": "bun run --cwd apps/native start",
    "release:ios": "cd apps/native && npx --yes eas-cli@latest build --platform ios --profile production --auto-submit",
    "dev:native:web": "bun run --cwd apps/native web",
    "test:native:e2e": "playwright test --config playwright.native.config.ts",
    "wiki:dump": "bun packages/wiki-import/src/dump-cli.ts",
    "wiki:backup-in-r2": "bun packages/wiki-import/src/backup-cli.ts",
    "wiki:upload-images-r2": "bun packages/wiki-import/src/upload-images-cli.ts",
    "db:seed:local": "bun packages/db/src/seed/wiki-cli.ts",
    "db:seed:prod": "bun packages/db/src/seed/prod-cli.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.4.1",
    "@wiki-collection/config": "workspace:*",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
