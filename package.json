{
  "name": "wiki-collection",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "db:generate": "turbo run db:generate -F @wiki-collection/db --",
    "deploy": "turbo run deploy -F @wiki-collection/infra --",
    "destroy": "turbo run destroy -F @wiki-collection/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "oxlint && oxfmt --write",
    "db:seed": "bun run --cwd packages/db seed",
    "dev:local": "bun run --cwd apps/web dev:local",
    "test": "bun run --cwd packages/api test && bun run --cwd packages/wiki-import test",
    "wiki:import": "bun run --cwd packages/wiki-import import",
    "wiki:load": "bun run --cwd packages/wiki-import load"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.4.1",
    "@wiki-collection/config": "workspace:*",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
